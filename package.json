	},
	"keywords": [
		"obsidian",
		"github",
		"tracker",
		"issues",
		"pull-requests"
	],
	"author": "schaier-io",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^22.20.5",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"builtin-modules": "^5.4.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"obsidian": "^1.14.4",
		"ts-jest": "^29.4.15",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"date-fns": "^4.4.0",
		"octokit": "^5.0.5"
