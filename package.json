{
	"name": "github-tracker",
	"version": "1.2.0",
	"description": "Track GitHub issues and pull requests in Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
